{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roblox recipe story - core generation subset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "characters",
    "beats"
  ],
  "properties": {
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skin": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "shirtCol": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "shirtAccent": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "shirtTrim": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "pantsCol": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "shoeCol": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "hairCol": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "badgeCol": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "hair": {
            "enum": [
              "none",
              "spiky",
              "bob",
              "quiff",
              "cap",
              "tophat",
              "horns"
            ]
          },
          "shirtStyle": {
            "enum": [
              "plain",
              "hoodie",
              "varsity",
              "suit",
              "striped",
              "armor"
            ]
          },
          "variant": {
            "enum": [
              "normal",
              "buff_entity",
              "cat_plush"
            ]
          },
          "scale": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2.5
          },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "height": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.4
              },
              "width": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.4
              },
              "head": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.4
              }
            }
          },
          "accessories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "glasses",
                    "backpack",
                    "headphones"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            }
          },
          "badgeText": {
            "type": "string",
            "maxLength": 20
          },
          "catEars": {
            "type": "boolean"
          },
          "tail": {
            "type": "boolean"
          },
          "chestButton": {
            "type": "boolean"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recipe",
          "duration",
          "cast"
        ],
        "properties": {
          "recipe": {
            "enum": [
              "establish",
              "conversation",
              "reaction",
              "reveal",
              "chase",
              "classroom",
              "celebration",
              "confrontation",
              "evidence",
              "device"
            ]
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 180
          },
          "cast": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lead"
            ],
            "properties": {
              "lead": {
                "type": "string"
              },
              "other": {
                "type": "string"
              }
            }
          },
          "set": {
            "enum": [
              "street",
              "office",
              "classroom",
              "home",
              "lab",
              "arena"
            ]
          },
          "lighting": {
            "enum": [
              "day",
              "warm",
              "night",
              "alarm"
            ]
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "music"
      ],
      "properties": {
        "music": {
          "enum": [
            "none",
            "roblox_arcade"
          ]
        }
      }
    }
  }
}
